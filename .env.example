# ── Insafdaar stack environment ─────────────────────────────────
# Copy to .env for docker-compose. All values here are placeholders;
# use real credentials in .env (gitignored).

# Server
PORT=5000

# Database (compose passes these to db + backend)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_database_password
POSTGRES_DB=insafdaar_db
DB_USER=postgres
DB_PASSWORD=your_database_password
DB_HOST=db
DB_PORT=5432
DB_DATABASE=insafdaar_db

# Auth
JWT_SECRET=your_super_secret_jwt_key_here

# INTERNAL_API_KEY: shared secret for service-to-service auth (drafting,
# legal-rag, backend call each other with it).
INTERNAL_API_KEY=your_shared_internal_service_secret

# Browser/API origins allowed by CORS (comma separated). Add the
# deployed origin (e.g. https://app.example.com) in production.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# SMTP Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_specific_password
SMTP_FROM=your_email@gmail.com
ADMIN_EMAIL=admin email here

# Google Calendar (meetings feature — must be passed to the backend via
# compose for calendar integration to work)
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project-id.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
GOOGLE_IMPERSONATE_USER_EMAIL=calendar-admin@yourdomain.com
GOOGLE_CALENDAR_ID=primary

# Frontend (browser-facing)
REACT_APP_API_BASE_URL=http://localhost:5000
REACT_APP_VOICE_SERVICE_URL=http://localhost:8000

# Backend → AI services (compose network names)
LEGAL_RAG_API_URL=http://legal-rag:8080
LEGAL_RAG_TIMEOUT_MS=45000
LEGAL_ASSISTANT_GUEST_PROMPT_LIMIT=3
DRAFTING_ASSISTANT_URL=http://drafting:8080
DRAFTING_ASSISTANT_TIMEOUT_MS=45000
DRAFTING_ASSISTANT_GENERATE_TIMEOUT_MS=90000

# AI stack secrets
RAG_GEMINI_API_KEY=your_gemini_api_key
DRAFTING_GEMINI_API_KEY=your_gemini_api_key
VOICE_GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
WEAVIATE_API_KEY=your_weaviate_api_key
DRIVE_ROOT_FOLDER_ID=your_google_drive_folder_id
DRIVE_ALLOWED_EXTS=pdf,txt
VOICE_WEBHOOK_SECRET=your_webhook_secret