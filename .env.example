# Server
PORT=5000

# Database
DB_USER=postgres
DB_PASSWORD=your_database_password
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=insafdaar_db

# Docker Compose Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_database_password
POSTGRES_DB=insafdaar_db

# JWT
JWT_SECRET=your_super_secret_jwt_key_here
# INTERNAL_API_KEY: Shared secret for internal service-to-service auth.
# REQUIRED for backend /internal/* routes used by Cloud Run drafting-assistant.
# Must match Cloud Run drafting-assistant secret value.
INTERNAL_API_KEY=your_shared_internal_service_secret
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# SMTP Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_specific_password
SMTP_FROM=your_email@gmail.com

# Admin
ADMIN_EMAIL=admin email here

# Google Calendar
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project-id.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
GOOGLE_IMPERSONATE_USER_EMAIL=calendar-admin@yourdomain.com
GOOGLE_CALENDAR_ID=primary

# Frontend
REACT_APP_API_BASE_URL=http://localhost:5000
REACT_APP_CHAT_HISTORY_API=http://localhost:4000
REACT_APP_LEGAL_RAG_API=
REACT_APP_VOICE_SERVICE_URL=https://your-voice-service.run.app

# Voice Intake Agent
VOICE_SERVICE_URL=
VOICE_WEBHOOK_SECRET=your-webhook-secret

# Legal RAG Proxy (backend -> Cloud Run)
LEGAL_RAG_API_URL=
# Set false for local Docker/dev when Cloud Run auth is not configured.
# Set true in production when Cloud Run is private.
LEGAL_RAG_REQUIRE_AUTH=false
LEGAL_RAG_AUDIENCE=
LEGAL_RAG_TIMEOUT_MS=45000
LEGAL_ASSISTANT_GUEST_PROMPT_LIMIT=3
GCP_RAG_KEY_PATH=./secrets/gcp-rag-invoker.json

# Drafting Assistant (backend -> Cloud Run drafting service)
DRAFTING_ASSISTANT_URL=
DRAFTING_ASSISTANT_TIMEOUT_MS=45000
DRAFTING_ASSISTANT_GENERATE_TIMEOUT_MS=90000

# ─── Local AI stack (replaces Cloud Run microservices) ───
# Gemini API keys from https://aistudio.google.com/apikey (free tier, no billing).
# Ideally use three separate keys/projects so quotas don't share a pool.
RAG_GEMINI_API_KEY=your_gemini_api_key
DRAFTING_GEMINI_API_KEY=your_gemini_api_key
VOICE_GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# Weaviate (runs as a compose service; key you choose yourself)
WEAVIATE_API_KEY=choose-a-long-random-string

# Google Drive corpus for RAG ingestion (shared with legal-rag's service account)
DRIVE_ROOT_FOLDER_ID=your_drive_root_folder_id

# Voice service
# Browser-facing URL (localhost keeps mic access working over plain http)
REACT_APP_VOICE_SERVICE_URL=http://localhost:8002

